# ==== 数据库 ====
POSTGRES_USER=s3mig
POSTGRES_PASSWORD=change-me
POSTGRES_DB=s3mig
# 后端连接串（docker-compose 中默认指向 db 服务）
DATABASE_URL=postgresql+asyncpg://s3mig:change-me@db:5432/s3mig

# ==== 认证 ====
# 务必替换为足够长的随机字符串，例如: openssl rand -hex 32
JWT_SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 存储连接密钥加密口令（上线后不要再改，否则已保存的连接无法解密）
MASK_KEY=please-change-this-too

# ==== 服务 ====
LOG_LEVEL=INFO
WEB_PORT=8080
